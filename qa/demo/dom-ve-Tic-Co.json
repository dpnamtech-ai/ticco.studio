 câu chữ mẹ đẻ, tinh thần hào sảng, thái độ xởi lởi, lao động hăng say,..","x":432,"y":273,"w":336,"h":124,"fs":19.7719,"fw":"400","ls":"-0.9867px","lh":"24.7055px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"Những điều bình thường và chân thật được ghi lại với một thái độ khác - vui, nghệ, gần gũi.","x":432,"y":422,"w":336,"h":74,"fs":19.7719,"fw":"400","ls":"-0.9867px","lh":"24.7055px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"Châm ngôn là làm mọi thứ với niềm vui giản đơn và sự tò mò với đời.","x":869,"y":308,"w":336,"h":49,"fs":19.7719,"fw":"400","ls":"-0.9867px","lh":"24.7055px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"Tíc Cơ mong muốn lan toả lối sống phóng khoáng và tích cực, bước đi cùng bạn trong hành trình phát triển mình và khám phá cuộc sống hàng ngày theo những góc nhìn mới.","x":869,"y":382,"w":336,"h":124,"fs":19.7719,"fw":"400","ls":"-0.9867px","lh":"24.7055px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"nghệ","x":26,"y":735,"w":215,"h":57,"fs":98.8344,"fw":"600","ls":"-5.93285px","lh":"57.3172px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"một","x":26,"y":819,"w":173,"h":57,"fs":98.8344,"fw":"600","ls":"-5.93285px","lh":"57.3172px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"cách","x":26,"y":900,"w":211,"h":57,"fs":98.8344,"fw":"600","ls":"-5.93285px","lh":"57.3172px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"đời","x":209,"y":1081,"w":131,"h":57,"fs":98.8344,"fw":"600","ls":"-5.93285px","lh":"57.3172px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"thường","x":33,"y":1149,"w":307,"h":57,"fs":98.8344,"fw":"600","ls":"-5.93285px","lh":"57.3172px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"ai","x":1143,"y":906,"w":76,"h":57,"fs":98.8344,"fw":"600","ls":"-5.93285px","lh":"57.3172px","color":"rgb(255, 255, 255)","ff":"beVietnam"},{"text":"cũng","x":1007,"y":967,"w":213,"h":57,"fs":98.8344,"fw":"600","ls":"-5.93285px","lh":"57.3172px","color":